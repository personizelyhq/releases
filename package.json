{
  "name": "@personizely/releases",
  "version": "0.5.3",
  "description": "Release notes from Markdown files: a public changelog, an in-app \"What's new\" embed and an unread-count API. Zero config.",
  "type": "module",
  "bin": {
    "releases": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx watch --include \"src/**\" src/cli.ts dev --cwd examples",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js serve --cwd examples",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "changelog",
    "release-notes",
    "whats-new",
    "product-updates",
    "markdown",
    "unread-badge",
    "hono",
    "sqlite"
  ],
  "author": "Personizely",
  "license": "MIT",
  "homepage": "https://github.com/personizelyhq/releases#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personizelyhq/releases.git"
  },
  "bugs": {
    "url": "https://github.com/personizelyhq/releases/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "marked": "^18.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
